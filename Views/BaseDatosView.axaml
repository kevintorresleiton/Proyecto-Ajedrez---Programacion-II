<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JaqueAndo.ViewModels"
             x:Class="JaqueAndo.Views.BaseDatosView"
             x:DataType="vm:BaseDatosViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="← Volver al Menú" Command="{Binding VolverMenuCommand}" Background="#334155" Foreground="White" CornerRadius="6" Padding="10,6" Cursor="Hand"/>
                <TextBlock Grid.Column="1" Text="🗄️ Administración de Jugadores (SQLite)" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="20">
            <Grid ColumnDefinitions="*,320">
                <!-- DataGrid de Jugadores -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,15,10">
                        <TextBox Grid.Column="0" Text="{Binding FiltroTexto}" PlaceholderText="🔍 Buscar jugador por nombre o apellido..." Padding="10"/>
                        <Button Grid.Column="1" Content="Buscar" Command="{Binding CargarJugadoresCommand}" Background="#2563EB" Foreground="White" Margin="10,0,0,0" Padding="12,8" CornerRadius="6" Cursor="Hand"/>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Jugadores}" SelectedItem="{Binding JugadorSeleccionado}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" Background="#1E293B" Margin="0,0,15,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="*"/>
                            <DataGridTextColumn Header="ID FIDE" Binding="{Binding IdFide}" Width="100"/>
                            <DataGridTextColumn Header="Sexo" Binding="{Binding Sexo}" Width="60"/>
                            <DataGridCheckBoxColumn Header="Es Socio" Binding="{Binding EsSocio}" Width="80"/>
                            <DataGridTextColumn Header="Club" Binding="{Binding Club}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Formulario de Edición / Alta -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Gestionar Registro" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

                        <TextBlock Text="Nombre:" Foreground="White"/>
                        <TextBox Text="{Binding NombreForm}" Padding="8"/>

                        <TextBlock Text="Apellido:" Foreground="White"/>
                        <TextBox Text="{Binding ApellidoForm}" Padding="8"/>

                        <TextBlock Text="ID FIDE:" Foreground="White"/>
                        <TextBox Text="{Binding IdFideForm}" Padding="8"/>

                        <TextBlock Text="Club:" Foreground="White"/>
                        <TextBox Text="{Binding ClubForm}" Padding="8"/>

                        <CheckBox Content="Es Socio del Club" IsChecked="{Binding EsSocioForm}" Foreground="White" Margin="0,5"/>

                        <StackPanel Spacing="10" Margin="0,10,0,0">
                            <Button Content="➕ Guardar / Crear" Command="{Binding GuardarJugadorCommand}" Background="#10B981" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" CornerRadius="6" Cursor="Hand"/>
                            <Button Content="✏️️ Cargar Datos Seleccionados" Command="{Binding CargarFormularioParaEditarCommand}" Background="#F59E0B" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" CornerRadius="6" Cursor="Hand"/>
                            <Button Content="🗑️ Eliminar Seleccionado" Command="{Binding EliminarJugadorCommand}" Background="#EF4444" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" CornerRadius="6" Cursor="Hand"/>
                            <Button Content="🧹 Limpiar Formulario" Command="{Binding LimpiarFormularioCommand}" Background="#64748B" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8" CornerRadius="6" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>