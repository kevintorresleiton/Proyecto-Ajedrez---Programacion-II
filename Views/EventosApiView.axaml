<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JaqueAndo.ViewModels"
             x:Class="JaqueAndo.Views.EventosApiView"
             x:DataType="vm:EventosApiViewModel"
             Background="#0F172A">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="← Volver al Menú" Command="{Binding VolverMenuCommand}" Background="#334155" Foreground="White" CornerRadius="6" Padding="10,6" Cursor="Hand"/>
                <TextBlock Grid.Column="1" Text="🌐 Consultas API REST - Lichess Org" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="🔄 Actualizar" Command="{Binding CargarTodoCommand}" Background="#2563EB" Foreground="White" Padding="10,6" CornerRadius="6" Cursor="Hand"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="20">
            <StackPanel Spacing="15">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding Cargando}" Height="4"/>

                <!-- Control de Pestañas -->
                <TabControl Background="#1E293B" CornerRadius="12" Padding="15">

                    <!-- Pestaña 1: Búsqueda por Perfil/ID -->
                    <TabItem Header="🔍 Buscar Jugador por ID">
                        <StackPanel Spacing="15" Margin="0,15,0,0" MaxWidth="600" HorizontalAlignment="Center">
                            <TextBlock Text="Ingresa el nombre de usuario/ID de Lichess:" Foreground="White" FontWeight="Bold"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding BusquedaId}" PlaceholderText="Ej: MagnusCarlsen, Hikaru, etc." Padding="10"/>
                                <Button Grid.Column="1" Content="Buscar" Command="{Binding BuscarJugadorCommand}" Background="#10B981" Foreground="White" Margin="10,0,0,0" Padding="14,8" CornerRadius="6" Cursor="Hand"/>
                            </Grid>

                            <TextBlock Text="{Binding MensajeBusqueda}" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Center"/>

                            <!-- Ficha Completa del Usuario Encontrado -->
                            <Border Background="#0F172A" CornerRadius="12" Padding="20" IsVisible="{Binding TieneUsuarioBuscado}">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="👤 Usuario:" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UsuarioBuscado.username}" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="📍 País / Ubicación:" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding UsuarioBuscado.NombrePais}" Foreground="#F59E0B" FontWeight="Bold"/>
                                    </StackPanel>

                                    <Separator Background="#334155"/>

                                    <Grid ColumnDefinitions="*,*,*">
                                        <!-- Blitz -->
                                        <Border Grid.Column="0" Background="#1E293B" Padding="10" CornerRadius="6" Margin="2">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="⚡ Blitz" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding UsuarioBuscado.perfs.blitz.rating, StringFormat='{}{0} ELO'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Rapid -->
                                        <Border Grid.Column="1" Background="#1E293B" Padding="10" CornerRadius="6" Margin="2">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="⏱️ Rápido" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding UsuarioBuscado.perfs.rapid.rating, StringFormat='{}{0} ELO'}" Foreground="#10B981" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Classical -->
                                        <Border Grid.Column="2" Background="#1E293B" Padding="10" CornerRadius="6" Margin="2">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🏛️ Clásico" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding UsuarioBuscado.perfs.classical.rating, StringFormat='{}{0} ELO'}" Foreground="#F59E0B" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- Pestaña 2: Top Mundial -->
                    <TabItem Header="🌍 Top 10 Mundial">
                        <ListBox ItemsSource="{Binding TopMundo}" Background="#0F172A" CornerRadius="8" Margin="0,10,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding username}" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding perfs.blitz.rating, StringFormat='⚡ {0} ELO'}" Foreground="#10B981" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>

                    <!-- Pestaña 3: Torneos Activos -->
                    <TabItem Header="⚔️ Torneos Activos">
                        <ListBox ItemsSource="{Binding Torneos}" Background="#0F172A" CornerRadius="8" Margin="0,10,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,3">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding fullName}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                            <Border Grid.Column="1" Background="#334155" Padding="6,2" CornerRadius="4" Margin="10,0">
                                                <TextBlock Text="{Binding perfType}" Foreground="#38BDF8" FontSize="12"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding minutes, StringFormat='⏱️ {0}m'}" Foreground="#10B981" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>

                </TabControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>