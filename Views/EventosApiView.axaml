<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JaqueAndo.ViewModels"
             x:Class="JaqueAndo.Views.EventosApiView"
             x:DataType="vm:EventosApiViewModel">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#0F172A" Padding="20,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="← Volver al Menú" Command="{Binding VolverMenuCommand}" Background="#334155" Foreground="White" CornerRadius="6" Padding="10,6" Cursor="Hand"/>
                <TextBlock Grid.Column="1" Text="🌐 Consultas API - Torneos Lichess / FIDE" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="30">
            <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Center">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Torneos y Eventos de Ajedrez Activos en Tiempo Real" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="🔄 Actualizar Torneos" Command="{Binding CargarEventosCommand}" Background="#2563EB" Foreground="White" Padding="12,8" CornerRadius="6" Cursor="Hand"/>
                </Grid>

                <ProgressBar IsIndeterminate="True" IsVisible="{Binding Cargando}" Height="4"/>

                <ListBox ItemsSource="{Binding Torneos}" Background="#1E293B" CornerRadius="12" Padding="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F172A" CornerRadius="8" Padding="15" Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding fullName}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding id, StringFormat='ID Evento: {0}'}" FontSize="12" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#334155" Padding="8,4" CornerRadius="4" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding perfType}" Foreground="#38BDF8" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding minutes, StringFormat='⏱️️ {0} min'}" Foreground="#10B981" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>